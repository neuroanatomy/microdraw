{
  "name": "microdraw",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node ./bin/www",
    "debug": "node --inspect-brk ./bin/www",
    "lint": "eslint .",
    "verify-vendor": "node scripts/verify-vendor.js",
    "mocha": "cross-env MONGODB_TEST='127.0.0.1:27017/circleci_test' LOCALSIGNIN=true mocha test/mocha.test.js test/api/runner.js 'test/api/**/*.spec.js'",
    "mocha-brk": "cross-env MONGODB_TEST='127.0.0.1:27017/circleci_test' mocha test/mocha.test.js --inspect-brk --timeout=10000000",
    "test-e2e": "cross-env MONGODB_TEST='127.0.0.1:27017/circleci_test' LOCALSIGNIN=true nyc --silent mocha ./test/e2e/runner.js ./test/e2e/*.spec.js --timeout=10000",
    "prepare": "husky install",
    "build-pages": "webpack --mode production --config webpack.pages.config.js && cp app/views/scripts/dist/*-page.js app/public/js/pages/",
    "dev-pages": "webpack --mode development --config webpack.pages.config.js && cp app/views/scripts/dist/*-page.js app/public/js/pages/"
  },
  "dependencies": {
    "body-parser": "^1.20.8",
    "cross-env": "^7.0.3",
    "dateformat": "^3.0.2",
    "debug": "^4.4.3",
    "dompurify": "^3.4.16",
    "express": "^4.22.3",
    "jsdom": "^16.4.0",
    "lodash": "^4.18.1",
    "monk": "^7.1.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mustache-express": "^1.3.2",
    "neuroweblab": "github:neuroanatomy/neuroweblab#3eface3d5bb5bf78b35cad9d984a655884dcdce6",
    "nwl-components": "^1.3.19",
    "passport": "^0.4.0",
    "passport-github": "^1.1.0",
    "serve-favicon": "^2.5.0",
    "vue": "^3.5.43",
    "ws": "^7.5.13"
  },
  "main": "app.js",
  "devDependencies": {
    "chai": "^4.2.0",
    "chai-http": "^4.2.1",
    "clean-webpack-plugin": "^0.1.19",
    "css-loader": "^6.6.0",
    "eslint": "^8.9.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.0",
    "lint-staged": "^13.0.3",
    "mocha": "^6.1.4",
    "nock": "^10.0.6",
    "nyc": "^15.1.0",
    "puppeteer": "^21.1.0",
    "sinon": "^7.3.1",
    "style-loader": "^3.3.1",
    "webpack": "^5.69.1",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.9.2"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  },
  "author": "Roberto Toro <rto@braincatalogue.org> (https://neuroanatomy.github.io)",
  "license": "GPL-3.0",
  "description": "",
  "overrides": {
    "neuroweblab": {
      "bcrypt": "npm:bcryptjs@^3.0.3"
    }
  }
}
