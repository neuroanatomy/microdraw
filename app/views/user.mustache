<!DOCTYPE html>
<html lang="en">

<head>
    {{> partials/header }}
    <link rel="stylesheet" type="text/css" href="/lib/nwl-components/fonts.css" />
    <link rel="stylesheet" type="text/css" href="/css/ui.css" />
    <link href='/lib/roboto/roboto.css' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" type="text/css" href="/css/user-style.css" />
</head>

<body>

<div id="app"></div>
<script type="text/html" id="template">
<UserPage :user='userInfo'>
    <template v-slot:side>
        [[projects.length]] Projects
    </template>
    <template v-slot:content>
        <Tabs>
            <Tab title="Projects">
                <Table id="projects">
                    <thead>
                        <tr>
                            <sortable-th :sort="sort" column="Name">Name</sortable-th>
                            <sortable-th :sort="sort" column="Files">Files</sortable-th>
                            <sortable-th :sort="sort" column="Collaborators">Collaborators</sortable-th>
                            <sortable-th :sort="sort" column="Owner">Owner</sortable-th>
                            <sortable-th :sort="sort" column="Last modified">Last modified</sortable-th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr v-for="project in sortedRows">
                        <td class="nwl-break-anywhere">
                            <a :href="`/project/${project.shortname}/settings`" class="settings">
                                <img style="width:11px; margin:3px 8px 0 0" src="/lib/nwl-components/icons/settings.svg"/>
                            </a>
                            <a :href="`/project/${project.shortname}`">
                                [[project.shownName]]
                            </a>
                        </td>
                        <td>[[project.numFiles]]</td>
                        <td>[[project.numCollaborators]]</td>
                        <td>
                            <a :href="`/user/${project.owner}`">
                                [[project.owner]]
                            </a>
                        </td>
                        <td :title="localDate(project.modified, true) || null">[[localDate(project.modified)]]</td>
                    </tr>
                    </tbody>
                </Table>
            </Tab>
            <Tab title="Datasets">
                <Table id="datasets" v-if="datasets.length > 0">
                    <thead>
                        <tr>
                            <sortable-th :sort="datasetSort" column="Name">Name</sortable-th>
                            <sortable-th :sort="datasetSort" column="Projects">Projects</sortable-th>
                            <sortable-th :sort="datasetSort" column="Included">Included</sortable-th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr v-for="dataset in sortedDatasets">
                        <td class="nwl-break-anywhere" :title="dataset.url">
                            <a :href="datasetURL(dataset)">[[dataset.name]]</a>
                        </td>
                        <td class="nwl-break-anywhere">
                            <template v-for="(shortname, i) in dataset.projects"><template v-if="i > 0">, </template><a :href="`/project/${shortname}`">[[shortname]]</a></template>
                        </td>
                        <td :title="localDate(dataset.included, true) || null">[[localDate(dataset.included)]]</td>
                    </tr>
                    </tbody>
                </Table>
                <p id="noDatasets" class="emptyState" v-if="datasetsLoaded && datasets.length === 0">No datasets yet.</p>
            </Tab>
            <Tab title="Annotations">
                <Table id="annotations" v-if="annotations.length > 0">
                    <thead>
                        <tr>
                            <sortable-th :sort="annotationSort" column="Dataset">Dataset</sortable-th>
                            <sortable-th :sort="annotationSort" column="Project">Project</sortable-th>
                            <sortable-th :sort="annotationSort" column="Slices">Slices</sortable-th>
                            <sortable-th :sort="annotationSort" column="Last modified">Last modified</sortable-th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr v-for="row in sortedAnnotations">
                        <td class="nwl-break-anywhere" :title="row.url">
                            <a :href="viewerURL(row.url, row.project)">[[row.name]]</a>
                        </td>
                        <td class="nwl-break-anywhere">
                            <a :href="`/project/${row.project}`">[[row.project]]</a>
                        </td>
                        <td>[[row.slices]]</td>
                        <td :title="localDate(row.modified, true) || null">[[localDate(row.modified)]]</td>
                    </tr>
                    </tbody>
                </Table>
                <p id="noAnnotations" class="emptyState" v-if="annotationsLoaded && annotations.length === 0">No annotations yet.</p>
            </Tab>
       </Tabs>
    </template>
</UserPage>
</script>
<style>
#projects, #datasets, #annotations {
    table-layout: auto;
}
#projects a, #datasets a, #annotations a {
    text-decoration: none;
}
.emptyState {
    margin: 10px;
    opacity: 0.7;
}
.settings {
    opacity: 0.5;
    transition: opacity 500ms;
}
.settings:hover {
    opacity: 1;
}
</style>

<script>
const userInfo={{{userInfo}}};
const loggedUser={{{loggedUser}}};
</script>
<script src="/js/pages/user-page.js"></script>


