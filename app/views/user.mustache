<!DOCTYPE html>
<html>

<head>
    {{> partials/header }}
    <link rel="stylesheet" type="text/css" href="/css/ui.css" />
    <link href='/lib/roboto/roboto.css' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" type="text/css" href="/css/user-style.css" />
</head>

<body>

<div id="app"></div>
<script type="text/html" id="template">
<UserPage :user='userInfo'>
    <template v-slot:side>
        [[projects.length]] Projects
    </template>
    <template v-slot:content>
        <Tabs>
            {{! The Datasets and Atlas Files tabs come back when stage 3 (T002 3.3, 3.4)
                gives them real data; until then their routes answer empty lists. }}
            <Tab title="Projects">
                <Table id="projects">
                    <thead>
                        <tr>
                            <sortable-th :sort="sort" column="Name">Name</sortable-th>
                            <sortable-th :sort="sort" column="Files">Files</sortable-th>
                            <sortable-th :sort="sort" column="Collaborators">Collaborators</sortable-th>
                            <sortable-th :sort="sort" column="Owner">Owner</sortable-th>
                            <sortable-th :sort="sort" column="Last modified">Last modified</sortable-th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr v-for="project in sortedRows">
                        <td>
                            <a :href="`/project/${project.shortname}/settings`" class="settings">
                                <img style="width:11px; margin:3px 8px 0 0" src="/img/settings.svg"/>
                            </a>
                            <a :href="`/project/${project.shortname}`">
                                [[project.shownName]]
                            </a>
                        </td>
                        <td>[[project.numFiles]]</td>
                        <td>[[project.numCollaborators]]</td>
                        <td>
                            <a :href="`/user/${project.owner}`">
                                [[project.owner]]
                            </a>
                        </td>
                        <td :title="localDate(project.modified, true) || null">[[localDate(project.modified)]]</td>
                    </tr>
                    </tbody>
                </Table>
            </Tab>
       </Tabs>
    </template>
</UserPage>
</script>
<style>
#projects {
    table-layout: auto;
}
#projects a {
    text-decoration: none;
}
.settings {
    opacity: 0.5;
    transition: opacity 500ms;
}
.settings:hover {
    opacity: 1;
}
</style>

<script>
const userInfo={{{userInfo}}};
const loggedUser={{{loggedUser}}};
</script>
<script src="/js/pages/user-page.js"></script>


<script>
  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

  ga('create', 'UA-50078058-2', 'auto');
  ga('send', 'pageview');

</script>

<script defer src="https://brainspell.pasteur.fr/umami/script.js" data-website-id="ac781e5e-bcd5-4f45-9f26-0729c9e348aa"></script>

</body>
</html>
