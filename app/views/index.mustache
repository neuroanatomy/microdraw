<script>
var vid = document.getElementById("neurons");
vid.autoplay = true;
vid.muted = true;
vid.loop = true;
vid.playbackRate = 0.5;

// No jQuery since M4c (2026-10-13); test/e2e/landing-page.spec.js was written
// on the jQuery version and passes unchanged. (The `.download>a` links that a
// jQuery loop rewrote are all inside the HTML comment above: nothing to do.)
var slide = document.querySelector(".slide");
var neurons = document.querySelector("#neurons");
var menu = document.querySelector("#menu");
var footer = document.querySelector("#footer");
var urlField = document.querySelector("#url");
var list = document.querySelector("#list");

slide.style.height = window.innerHeight + "px";
window.addEventListener('resize', function() {
    slide.style.height = window.innerHeight + "px";
    neurons.style.width = window.innerWidth + "px";
});

// List of brains
list.addEventListener('change', function() {
    urlField.value = list.value;
});

var menuShowing = true;
window.addEventListener('scroll', function() {
    var y = window.pageYOffset;
    if(y>100 && menuShowing) {
        menu.style.top = "-32px";
        menu.style.opacity = "0";
        menuShowing = false;

        // jQuery's show(): clear an inline display:none (the CSS shows it)
        if(footer.style.display === "none") {
            footer.style.display = "";
        }
    }
    if(y<100 && !menuShowing) {
        menu.style.top = "0px";
        menu.style.opacity = "1";
        menuShowing = true;
    }
});

document.querySelectorAll("h2").forEach(function(h2) {
    h2.style.marginLeft = "0px";
    h2.style.opacity = "1";
});

function goToURL(e) {
    var url=urlField.value;
    location="/data?source="+url;
}

// Add URL loading
urlField.addEventListener('keyup', function(e) {
    if (e.keyCode == 13) {
        goToURL(e);
    }
});
</script>

<script defer src="https://brainspell.pasteur.fr/umami/script.js" data-website-id="ac781e5e-bcd5-4f45-9f26-0729c9e348aa"></script>

</body>
</html>
