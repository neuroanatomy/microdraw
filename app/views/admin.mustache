<!DOCTYPE html>
<html>

<head>
    {{> partials/header }}
    <link rel="stylesheet" type="text/css" href="/css/ui.css" />
    <link href='/lib/roboto/roboto.css' rel='stylesheet' type='text/css'>
</head>

<body>

<div id="app"></div>
<script type="text/html" id="template">
<Wrapper>
  <Header>
    <span class="title">Admin</span>
  </Header>
  <main>
    <section id="orphans">
      <h2>Orphan annotations</h2>
      <p class="help">
        Annotations whose project is empty or missing (saved outside a project, before
        saving required one), or names a project that does not exist (any more). They are
        grouped by image, slice, author and the project they carry. <b>Delete</b> marks them
        as backups, like an older version: nothing is erased, and it can be undone.
        <b>Assign</b> moves them into a project.
      </p>
      <form class="toolbar" @submit.prevent="search()">
        <input v-model="sourceFilter" type="text" placeholder="Only this image (source URL), or leave empty for all">
        <Button :disabled="loading">[[loading ? 'Searching…' : 'Search']]</Button>
      </form>
      <p v-if="error" class="error">[[error]]</p>
      <p v-if="result" class="result">
        [[result.text]]
        <Button v-if="result.undo" class="undo" @click="undo(result.undo)">Undo</Button>
      </p>
      <p v-if="!loading && loaded && total === 0" class="none">No orphan annotations found.</p>
      <template v-if="total > 0">
        <p class="paging">
          [[skip + 1]]–[[skip + list.length]] of [[total]] groups
          <Button :disabled="skip === 0 || loading" @click="page(-1)">Previous</Button>
          <Button :disabled="skip + list.length >= total || loading" @click="page(1)">Next</Button>
        </p>
        <Table id="orphan-list">
          <thead>
            <tr><th>Image</th><th>Slice</th><th>Author</th><th>Project</th><th>Regions</th><th>Last modified (UTC)</th><th></th></tr>
          </thead>
          <tbody>
            <template v-for="g in list" :key="keyOf(g)">
              <tr class="orphan" :data-key="keyOf(g)">
                <td class="source"><a :href="viewerLink(g)" target="_blank">[[g.source]]</a></td>
                <td class="slice">[[g.slice]]</td>
                <td class="user">[[g.user === null ? '(none)' : g.user]]</td>
                <td class="project">
                  <span v-if="g.reason === 'none'">(none)</span>
                  <span v-else><code>[[g.project]]</code> <span class="tag">does not exist</span></span>
                </td>
                <td class="regions">[[g.regions]]</td>
                <td class="modified">[[formatDate(g.modified)]]</td>
                <td class="actions">
                  <Button class="assign" @click="toggleAssign(g)">Assign…</Button>
                  <Button className="danger" class="delete" @click="remove(g)">Delete</Button>
                </td>
              </tr>
              <tr v-if="assigning && keyOf(assigning.group) === keyOf(g)" class="details">
                <td colspan="7">
                  <p v-if="assigning.loading">Looking for projects that list this image…</p>
                  <template v-else>
                    <p v-if="assigning.candidates.length === 0" class="help">No project lists this image.</p>
                    <p v-else>Projects that list this image:</p>
                    <ul class="candidates">
                      <li v-for="p in assigning.candidates" :key="p.shortname">
                        <label>
                          <input type="radio" name="target" :value="p.shortname" v-model="assigning.target" @change="assigning.other = ''">
                          <code>[[p.shortname]]</code> [[p.name]]
                          <span v-if="p.existing" class="warning">
                            already has [[p.existing]] region(s) on this image<span v-if="p.existingByUser">, [[p.existingByUser]] by [[g.user]]</span>: both are kept
                          </span>
                        </label>
                      </li>
                      <li>
                        <label>
                          <input type="radio" name="target" value="" v-model="assigning.target">
                          Another project:
                        </label>
                        <input v-model="assigning.other" class="other" type="text" placeholder="project shortname" @focus="assigning.target = ''">
                        <label><input type="checkbox" v-model="assigning.addImage" class="add-image"> add the image to its files</label>
                      </li>
                    </ul>
                    <p class="help">
                      Annotations that the project already has on this image are kept: the two sets are
                      separate regions, and the viewer shows both. Assign when nobody has the image open
                      in that project: a save from an open page would mark the assigned regions as backups.
                    </p>
                    <Button class="do-assign" :disabled="!targetOf(assigning)" @click="assign()">Assign [[g.regions]] region(s) to [[targetOf(assigning) || '…']]</Button>
                    <Button @click="assigning = null">Cancel</Button>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </Table>
      </template>
    </section>
    <section id="project-tools">
      <h2>Projects</h2>
      <p class="help">
        Find a project by shortname or name. <b>Delete</b> does what the owner's delete does: the
        project's annotations become backups (nothing is erased) and the project is kept in the log,
        so it can be restored with its annotations. <b>Transfer ownership</b> gives the project to
        another user, who gets every right on it; the previous owner keeps only what the
        collaborators list gives him. Both can be undone with <b>Restore</b>.
      </p>
      <form class="toolbar" @submit.prevent="searchProjects()">
        <input v-model="projectQuery" class="project-search" type="text" placeholder="Project shortname or name">
        <Button class="do-search" :disabled="projectSearching">[[projectSearching ? 'Searching…' : 'Search']]</Button>
      </form>
      <p v-if="actionError" class="error">[[actionError]]</p>
      <p v-if="actionResult && actionResult.where === 'search'" :class="actionResult.error ? 'error' : 'result'">
        [[actionResult.error || actionResult.text]]
        <Button v-if="actionResult.restore || actionResult.restoreDeleted" class="restore-action" @click="restoreAction(actionResult)">Restore</Button>
      </p>
      <p v-if="projectSearched && !projectSearching && foundProjects.length === 0" class="none">No project found.</p>
      <div v-for="p in foundProjects" :key="p.shortname" class="project" :data-shortname="p.shortname">
        <h3>
          <code>[[p.shortname]]</code> [[p.name]]
          <span class="owner">owner: [[p.owner]] <span v-if="!p.ownerExists" class="tag">does not exist</span></span>
          <a class="settings" :href="'/project/' + encodeURIComponent(p.shortname) + '/settings'" target="_blank">Settings</a>
        </h3>
        <p class="counts">[[countsText(p.counts)]]</p>
        <ProjectActions :project="p" where="search"></ProjectActions>
      </div>
      <p v-if="foundMore" class="help">More projects match: refine the search.</p>
    </section>
    <section id="invalid-projects">
      <h2>Projects that don't validate</h2>
      <p class="help">
        Stored projects that the validation of project saves would flag, as
        <code>scripts/check-projects.js</code> lists them. <b>Remove blank rows</b> removes files with
        no source (even if they have a name), collaborators with no username and annotation layers
        with no name and no values. <b>Name unnamed layers</b> gives a name to layers that have values
        but no name. Both refuse a project changed since this list was loaded, and keep the previous
        version: <b>Restore</b> puts it back. Shortnames and users that don't exist are only listed:
        fix them in the project's settings.
      </p>
      <p v-if="projectsError" class="error">[[projectsError]]</p>
      <p v-if="projectsResult" class="result">
        [[projectsResult.text]]
        <Button v-if="projectsResult.restore" class="restore" @click="restoreProject(projectsResult)">Restore</Button>
      </p>
      <p v-if="actionResult && actionResult.where === 'invalid'" :class="actionResult.error ? 'error' : 'result action-result'">
        [[actionResult.error || actionResult.text]]
        <Button v-if="actionResult.restore || actionResult.restoreDeleted" class="restore-action" @click="restoreAction(actionResult)">Restore</Button>
      </p>
      <p v-if="projectsSummary" class="summary">
        [[projectsSummary.invalid]] of [[projectsSummary.total]] projects have problems;
        [[projectsSummary.refused]] cannot be saved again unchanged.
        <Button :disabled="projectsLoading" @click="loadProjects()">[[projectsLoading ? 'Loading…' : 'Reload']]</Button>
      </p>
      <div v-for="p in projects" :key="p.shortname" class="project" :data-shortname="p.shortname">
        <h3>
          <code>[[p.shortname]]</code> [[p.name]] <span class="owner">owner: [[p.owner]]</span>
          <a class="settings" :href="settingsLink(p)" target="_blank">Settings</a>
        </h3>
        <ul class="problems">
          <li v-for="(q, i) in p.problems.slice(0, PROBLEMS_SHOWN)" :key="i" :class="'problem kind-' + q.kind.replace(' ', '-')">
            <span class="tag">[[kindLabel[q.kind] ]]</span> [[q.message]]
          </li>
        </ul>
        <details v-if="p.problems.length > PROBLEMS_SHOWN">
          <summary>[[p.problems.length - PROBLEMS_SHOWN]] more</summary>
          <ul class="problems">
            <li v-for="(q, i) in p.problems.slice(PROBLEMS_SHOWN)" :key="i" :class="'problem kind-' + q.kind.replace(' ', '-')">
              <span class="tag">[[kindLabel[q.kind] ]]</span> [[q.message]]
            </li>
          </ul>
        </details>
        <p class="fixes">
          <Button v-if="blankCount(p) > 0" class="remove-blank" @click="removeBlankRows(p)">Remove blank rows ([[blankCount(p)]])</Button>
        </p>
        <ProjectActions :project="p" where="invalid"></ProjectActions>
        <form v-if="p.unnamedLayers.length > 0" class="name-layers" @submit.prevent="nameLayers(p)">
          <p>Name unnamed layers:</p>
          <label v-for="l in p.unnamedLayers" :key="l.index">
            Layer [[l.index + 1]] ([[l.type]], values: <code>[[valuesText(l.values)]]</code>)
            <input type="text" v-model="layerNames[p.shortname][l.index]" :data-index="l.index">
          </label>
          <Button class="do-name-layers">Name [[p.unnamedLayers.length]] layer(s)</Button>
        </form>
      </div>
    </section>
  </main>
  <Footer/>
</Wrapper>
</script>
<script type="text/html" id="project-actions-template">
  <div class="project-actions">
    <Button className="danger" class="delete-project" @click="remove()">Delete…</Button>
    <Button class="transfer" @click="toggle()">Transfer ownership…</Button>
    <div v-if="open" class="transfer-form">
      <label>New owner: <input v-model="q" class="user-search" type="text" placeholder="Search users by username" @input="findUsers()"></label>
      <span v-for="u in users" :key="u.username">
        <Button :class="'pick-user' + (chosen === u.username ? ' chosen' : '')" :data-username="u.username" @click="chosen = u.username">[[u.username]]<span v-if="u.name"> ([[u.name]])</span></Button>
      </span>
      <p v-if="q.trim() && users.length === 0" class="help">No user found.</p>
      <Button class="do-transfer" :disabled="!chosen" @click="transfer()">Give [[project.shortname]] to [[chosen || '…']]</Button>
      <Button @click="toggle()">Cancel</Button>
    </div>
  </div>
</script>
<style>
main {
    padding: 0 20px;
}
section {
    background: #333;
    padding: 20px;
    margin-bottom: 20px;
    overflow-x: auto;
    text-align: left;
}
section h2 {
    font-size: 14px;
    margin: 0 0 10px;
}
section a {
    color: #fff;
}
section table {
    margin-left: 0;
    margin-top: 10px;
    table-layout: auto;
}
section td {
    padding: 2px 6px;
}
td.source {
    word-break: break-all;
}
td.actions {
    text-align: right;
    white-space: nowrap;
}
tr.details td {
    background: #2a2a2a;
}
ul.candidates {
    list-style: none;
    padding-left: 0;
}
ul.candidates li {
    margin: 6px 0;
}
.toolbar {
    display: flex;
    gap: 5px;
}
input[type=text] {
    color: #fff;
    background: #222;
    font: inherit;
    padding: 6px;
    border: 1px solid #777;
    border-radius: 3px;
}
.toolbar input[type=text] {
    flex: 1;
}
button.danger {
    border-color: #c55;
    color: #f99;
}
.help {
    color: #aaa;
}
.error, .tag {
    color: #f77;
}
.warning {
    color: #fc6;
}
.result {
    color: #8d8;
}
.tag {
    font-size: 11px;
    border: 1px solid #c55;
    border-radius: 3px;
    padding: 0 3px;
}
code {
    font-size: 12px;
}
div.project {
    border-top: 1px solid #555;
    padding: 10px 0;
}
div.project p, div.project form {
    text-align: left;
}
div.project h3 {
    font-size: 13px;
    margin: 0 0 6px;
}
div.project .owner {
    color: #aaa;
    font-weight: normal;
    margin: 0 10px;
}
ul.problems {
    margin: 4px 0;
    padding-left: 20px;
}
.kind-blocking .tag {
    background: #733;
}
.kind-warning .tag, .kind-shortname .tag, .kind-missing-user .tag {
    color: #fc6;
    border-color: #a83;
}
div.project .counts {
    color: #aaa;
    margin: 0 0 6px;
}
div.project-actions {
    margin: 6px 0;
}
div.transfer-form {
    margin-top: 6px;
    padding: 6px;
    background: #2a2a2a;
}
div.transfer-form button.chosen {
    border-color: #8d8;
    color: #8d8;
}
form.name-layers label {
    display: block;
    margin: 4px 0;
}
form.name-layers input {
    margin-left: 6px;
}
</style>

<script>
const loggedUser={{{loggedUser}}};
</script>
<script src="/js/pages/admin-page.js"></script>

</body>
</html>
